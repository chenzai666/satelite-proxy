# Normalize all text files to LF in the repository.
# Working-copy line endings are handled per-platform by Git's autocrlf:
#   - macOS / Linux: LF everywhere (matches repo)
#   - Windows:       checked out as CRLF, committed back as LF
* text=auto eol=lf

# Source code — always LF, even on Windows checkouts.
*.rs    text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binaries — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
