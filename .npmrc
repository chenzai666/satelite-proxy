# Use the rsproxy.cn mirror for faster installs in China.
registry=https://rsproxy.cn/

# pnpm resolves every optional dependency in the lockfile, including
# other-platform packages like @esbuild/linux-s390x which rsproxy does not
# mirror (HTTP 404). supportedArchitectures restricts optional-dep resolution
# to the current platform only, so missing cold-platform packages are skipped.
supported-architectures.os[]=current
supported-architectures.cpu[]=current
